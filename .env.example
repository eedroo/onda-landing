# Credenciais OAuth criadas no Google Cloud Console (Credentials > OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obtido uma única vez correndo: npm run get-refresh-token
GOOGLE_REFRESH_TOKEN=

# Calendário onde as reuniões marcadas por clientes são criadas
# (normalmente "primary" = a tua agenda principal)
GOOGLE_CALENDAR_ID=primary

# Calendário SEPARADO onde TU marcas blocos de disponibilidade — cada
# evento aqui vira horários que os clientes podem escolher. Cria um
# calendário novo no Google Agenda (ex: "Disponibilidade Onda") e cola
# aqui o "Calendar ID" dele (Definições e partilha > Integrar calendário).
GOOGLE_AVAILABILITY_CALENDAR_ID=

# Regras de disponibilidade (opcionais, valores por omissão já sensatos)
TIMEZONE=Europe/Lisbon
MEETING_DURATION_MINUTES=30
BOOKING_WINDOW_DAYS=14
MIN_NOTICE_HOURS=12
