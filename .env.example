# Credenciais OAuth criadas no Google Cloud Console (Credentials > OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obtido uma única vez correndo: npm run get-refresh-token
GOOGLE_REFRESH_TOKEN=

# ID do calendário a usar (normalmente "primary" = a tua agenda principal)
GOOGLE_CALENDAR_ID=primary

# Regras de disponibilidade (todos opcionais, valores por omissão já sensatos)
TIMEZONE=Europe/Lisbon
MEETING_DURATION_MINUTES=30
WORKING_HOURS_START=09:00
WORKING_HOURS_END=18:00
WORKING_DAYS=1,2,3,4,5
BOOKING_WINDOW_DAYS=14
MIN_NOTICE_HOURS=12
